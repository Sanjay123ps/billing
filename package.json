{
  "name": "ayini-billing",
  "version": "1.0.0",
  "description": "Ayini Home Products — Billing & Inventory System",
  "author": "Ayini Home Products",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "electron:dev": "NODE_ENV=development electron .",
    "build:win": "electron-builder build --win --x64",
    "build:mac": "electron-builder build --mac",
    "build:linux": "electron-builder build --linux",
    "dist": "electron-builder"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.ayini.billing",
    "productName": "Ayini Billing",
    "copyright": "© 2025 Ayini Home Products",
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*",
      "server.js",
      "db.js",
      "routes/**/*",
      "middleware/**/*",
      "public/**/*",
      ".env"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build-assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "db.js",
      "routes/**/*",
      "middleware/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!dist/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
"nsis": {
  "oneClick": false,
  "allowToChangeInstallationDirectory": true,
  "createDesktopShortcut": true,
  "createStartMenuShortcut": true,
  "shortcutName": "Ayini Billing",
  "guid": "com.ayini.billing",
  "allowElevation": true,
  "deleteAppDataOnUninstall": false
},

    "mac": {
      "target": "dmg",
      "icon": "build-assets/icon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build-assets/icon.png",
      "category": "Office"
    }
  }
}